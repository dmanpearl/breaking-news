SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=postgres://user:pass@host:5432/dbname  # leave blank for SQLite
#
# To run management commands against the Railway production DB from your local
# machine, set DATABASE_URL to the public proxy URL (not the internal one):
#   railway variables -k | grep DATABASE_PUBLIC_URL
# Paste the result as DATABASE_URL here. settings.py detects railway.internal
# hostnames and substitutes DATABASE_PUBLIC_URL automatically, so plain
# `railway run python manage.py ...` will then work with no extra flags.
